{
  "name": "coinfolio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Coinfolio: crypto portfolio tracker (KPI web course, topic 1)",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/scss/**/*.scss\" && node scripts/check-scss.mjs",
    "validate": "html-validate dist/*.html",
    "check": "node scripts/check.js",
    "check:css": "node scripts/check-css.mjs",
    "shot": "node scripts/shot.mjs",
    "test": "npm run build && npm run validate && npm run check && npm run check:css",
    "deploy": "npm test && gh-pages -d dist --dotfiles -m \"Deploy preview\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ejs": "^3.1.10",
    "eslint": "^9.39.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "html-validate": "^11.4.0",
    "puppeteer-core": "^25.13.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23"
  }
}
