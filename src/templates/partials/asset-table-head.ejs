<%# sortable: true on the Assets page (buttons that sort through the API), plain headings elsewhere %>
<% const sortable = locals.sortable === true; %>
<thead class="asset-table__head">
  <tr>
    <th class="asset-table__th" scope="col" data-i18n="table.rank"><%= t('table.rank') %></th>
    <th class="asset-table__th" scope="col"<%- sortable ? ' aria-sort="none"' : '' %>>
<% if (sortable) { %>
      <button class="asset-table__sort" type="button" data-sort="name">
        <%- include('icon', { name: 'sort', size: 14 }) %>
        <span data-i18n="table.asset"><%= t('table.asset') %></span>
      </button>
<% } else { %>
      <span data-i18n="table.asset"><%= t('table.asset') %></span>
<% } %>
    </th>
    <th class="asset-table__th asset-table__th--numeric" scope="col"<%- sortable ? ' aria-sort="none"' : '' %>>
<% if (sortable) { %>
      <button class="asset-table__sort" type="button" data-sort="price">
        <%- include('icon', { name: 'sort', size: 14 }) %>
        <span data-i18n="table.price"><%= t('table.price') %></span>
      </button>
<% } else { %>
      <span data-i18n="table.price"><%= t('table.price') %></span>
<% } %>
    </th>
    <th class="asset-table__th asset-table__th--numeric" scope="col"<%- sortable ? ' aria-sort="none"' : '' %>>
<% if (sortable) { %>
      <button class="asset-table__sort" type="button" data-sort="change24h">
        <%- include('icon', { name: 'sort', size: 14 }) %>
        <span data-i18n="table.change"><%= t('table.change') %></span>
      </button>
<% } else { %>
      <span data-i18n="table.change"><%= t('table.change') %></span>
<% } %>
    </th>
    <th class="asset-table__th asset-table__th--numeric" scope="col" data-i18n="table.holdings"><%= t('table.holdings') %></th>
    <th class="asset-table__th" scope="col" data-i18n="table.allocation"><%= t('table.allocation') %></th>
    <th class="asset-table__th" scope="col" data-i18n="table.chart"><%= t('table.chart') %></th>
    <th class="asset-table__th" scope="col"><span class="visually-hidden" data-i18n="table.actions"><%= t('table.actions') %></span></th>
  </tr>
</thead>
